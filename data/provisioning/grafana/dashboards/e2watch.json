          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT b.lat AS latitude, b.lon AS longitude, b.beschreibung AS \"Building\", sum(strom_kwh) FILTER (WHERE strom_kwh BETWEEN 0 AND 5000)/1000 AS \"Electricity (MWh)\" FROM e2watch.e2watch e JOIN e2watch.buildings b ON b.bilanzkreis_id::text = e.bilanzkreis_id WHERE $__timeFilter(e.timestamp) AND b.lat IS NOT NULL GROUP BY 1,2,3"
