        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(timestamp,'1d'), sum(strom_kwh) FILTER (WHERE strom_kwh BETWEEN 0 AND 5000)/1000 AS \"Electricity\", sum(waerme_kwh) FILTER (WHERE waerme_kwh BETWEEN 0 AND 5000)/1000 AS \"Heat\", avg(temperatur) AS \"Temperature\" FROM e2watch.e2watch WHERE $__timeFilter(timestamp) GROUP BY 1 ORDER BY 1"
        }
      ],
