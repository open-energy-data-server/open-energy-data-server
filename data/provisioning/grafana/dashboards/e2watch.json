          "rawSql": "SELECT left(b.beschreibung, 32) AS \"Building\", sum(waerme_kwh) FILTER (WHERE waerme_kwh BETWEEN 0 AND 5000)/1000 AS \"Heat (MWh)\" FROM e2watch.e2watch e JOIN e2watch.buildings b ON b.bilanzkreis_id::text = e.bilanzkreis_id WHERE $__timeFilter(e.timestamp) GROUP BY 1 ORDER BY 2 DESC NULLS LAST LIMIT 15"
