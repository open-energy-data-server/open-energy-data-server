    {
      "type": "barchart",
      "title": "Energy by building type",
      "description": "Electricity and heat per building type in the selected range (MWh). Type derived from the building name (school, daycare, administration, pool, sport, culture); swimming pools have the highest heat demand per building.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN b.beschreibung ~* 'schwimm|hallenbad' THEN 'Pool' WHEN b.beschreibung ~* 'verwaltung|rathaus|stadtbetrieb' THEN 'Administration' WHEN b.beschreibung ~* 'kita|kinder|familienzentrum' THEN 'Daycare' WHEN b.beschreibung ~* 'museum|theater|bibliothek' THEN 'Culture' WHEN b.beschreibung ~* 'gym|schule|\\mg?g?hs\\M|\\mgs\\M|\\mggs\\M|\\mrs\\M|gesamtschule|berufskolleg|kolleg' THEN 'School' WHEN b.beschreibung ~* 'halle|sport|umkleide' THEN 'Sport' ELSE 'Other' END AS \"Type\", sum(strom_kwh) FILTER (WHERE strom_kwh BETWEEN 0 AND 5000)/1000 AS \"Electricity\", sum(waerme_kwh) FILTER (WHERE waerme_kwh BETWEEN 0 AND 5000)/1000 AS \"Heat\" FROM e2watch.e2watch e JOIN e2watch.buildings b ON b.bilanzkreis_id::text = e.bilanzkreis_id WHERE $__timeFilter(e.timestamp) GROUP BY 1 ORDER BY 3 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "gradientMode": "none",
            "axisPlacement": "auto"
          },
