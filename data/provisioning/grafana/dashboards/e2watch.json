    {
      "type": "table",
      "title": "Buildings: annual overview",
      "description": "Per building in the selected range: electricity, heat, water, hours with data and the heat/electricity ratio.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT b.beschreibung AS \"Building\", CASE WHEN b.beschreibung ~* 'schwimm|hallenbad' THEN 'Pool' WHEN b.beschreibung ~* 'verwaltung|rathaus|stadtbetrieb' THEN 'Administration' WHEN b.beschreibung ~* 'kita|kinder|familienzentrum' THEN 'Daycare' WHEN b.beschreibung ~* 'museum|theater|bibliothek' THEN 'Culture' WHEN b.beschreibung ~* 'gym|schule|\\mg?g?hs\\M|\\mgs\\M|\\mggs\\M|\\mrs\\M|gesamtschule|berufskolleg|kolleg' THEN 'School' WHEN b.beschreibung ~* 'halle|sport|umkleide' THEN 'Sport' ELSE 'Other' END AS \"Type\", sum(strom_kwh) FILTER (WHERE strom_kwh BETWEEN 0 AND 5000) AS \"Electricity (kWh)\", sum(waerme_kwh) FILTER (WHERE waerme_kwh BETWEEN 0 AND 5000) AS \"Heat (kWh)\", sum(wasser_m3) FILTER (WHERE wasser_m3 BETWEEN 0 AND 100) AS \"Water (m3)\", count(*) AS \"Hours with data\", sum(waerme_kwh) FILTER (WHERE waerme_kwh BETWEEN 0 AND 5000)/NULLIF(sum(strom_kwh) FILTER (WHERE strom_kwh BETWEEN 0 AND 5000), 0) AS \"Heat / electricity\" FROM e2watch.e2watch e JOIN e2watch.buildings b ON b.bilanzkreis_id::text = e.bilanzkreis_id WHERE $__timeFilter(e.timestamp) GROUP BY 1,2 ORDER BY 3 DESC NULLS LAST"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
