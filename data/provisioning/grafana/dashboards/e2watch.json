    {
      "type": "timeseries",
      "title": "Daily electricity and heat of all buildings",
      "description": "Sum over all buildings per day (MWh), and the mean outdoor temperature (right axis). Heat follows the temperature; electricity is nearly constant. Implausible values are dropped: electricity < 0 or > 5000 kWh/h (meter resets, one spike of +-71,000 kWh), heat > 5000 kWh/h, water > 100 m3/h. The source is offline: the last data is from 2025-04-14 and coverage dropped from 160 to 2 buildings between 2024-12 and 2025-04. ",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
