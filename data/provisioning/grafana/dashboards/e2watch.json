          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT extract(hour from timestamp AT TIME ZONE 'Europe/Berlin')::int AS \"Hour\", avg(strom_kwh) FILTER (WHERE strom_kwh BETWEEN 0 AND 5000 AND extract(isodow from timestamp AT TIME ZONE 'Europe/Berlin') < 6) AS \"Electricity weekday\", avg(strom_kwh) FILTER (WHERE strom_kwh BETWEEN 0 AND 5000 AND extract(isodow from timestamp AT TIME ZONE 'Europe/Berlin') >= 6) AS \"Electricity weekend\", avg(waerme_kwh) FILTER (WHERE waerme_kwh BETWEEN 0 AND 5000 AND extract(isodow from timestamp AT TIME ZONE 'Europe/Berlin') < 6) AS \"Heat weekday\", avg(waerme_kwh) FILTER (WHERE waerme_kwh BETWEEN 0 AND 5000 AND extract(isodow from timestamp AT TIME ZONE 'Europe/Berlin') >= 6) AS \"Heat weekend\" FROM e2watch.e2watch WHERE $__timeFilter(timestamp) AND bilanzkreis_id = '$building' GROUP BY 1 ORDER BY 1"
