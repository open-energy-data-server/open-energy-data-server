          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(strom_kwh) FILTER (WHERE strom_kwh BETWEEN 0 AND 5000)/1000 AS \"Electricity\", sum(waerme_kwh) FILTER (WHERE waerme_kwh BETWEEN 0 AND 5000)/1000 AS \"Heat\", sum(wasser_m3) FILTER (WHERE wasser_m3 BETWEEN 0 AND 100) AS \"Water\", avg(temperatur) AS \"Mean temperature\" FROM e2watch.e2watch WHERE $__timeFilter(timestamp)"
