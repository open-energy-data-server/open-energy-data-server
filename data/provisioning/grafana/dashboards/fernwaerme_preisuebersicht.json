    {
      "type": "barchart",
      "title": "Durchschnittspreis je Bundesland",
      "description": "Mittlerer Fernwärmepreis (brutto, ct/kWh) je Bundesland für die drei Abnahmefälle. Unabhängig vom Bundesland-Filter.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select \"Bundesland\" as bundesland, avg(\"EFH in ct/kWh (brutto) EFH in ct/kWh = Einfamilienhaus Abnahmef\") as \"Einfamilienhaus\", avg(\"MFH in ct/kWh (brutto) MFH in ct/kWh = Mehrfamilienhaus Abnahme\") as \"Mehrfamilienhaus\", avg(\"Industrie in ct/kWh (brutto) Industrie in ct/kWh = Industrie bz\") as \"Industrie/Gewerbe\"\nfrom fernwaerme_preisuebersicht.fernwaerme_preisuebersicht group by 1 order by avg(\"EFH in ct/kWh (brutto) EFH in ct/kWh = Einfamilienhaus Abnahmef\") desc nulls last",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: ct/kWh",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "gradientMode": "none",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto"
          },
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Einfamilienhaus"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Mehrfamilienhaus"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Industrie/Gewerbe"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          }
        ]
      },
