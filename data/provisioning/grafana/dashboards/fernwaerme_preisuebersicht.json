          "rawQuery": true,
          "rawSql": "select to_char(floor(\"EFH in ct/kWh (brutto) EFH in ct/kWh = Einfamilienhaus Abnahmef\"/2)*2,'FM00') as \"ab ct/kWh\", count(*) as teilnetze from fernwaerme_preisuebersicht.fernwaerme_preisuebersicht where ('$bundesland'='Alle' or \"Bundesland\"='$bundesland') and \"EFH in ct/kWh (brutto) EFH in ct/kWh = Einfamilienhaus Abnahmef\" is not null group by floor(\"EFH in ct/kWh (brutto) EFH in ct/kWh = Einfamilienhaus Abnahmef\"/2) order by floor(\"EFH in ct/kWh (brutto) EFH in ct/kWh = Einfamilienhaus Abnahmef\"/2)",
          "refId": "A"
        }
