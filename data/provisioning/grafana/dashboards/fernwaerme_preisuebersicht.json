          "format": "table",
          "rawQuery": true,
          "rawSql": "select * from (select 'Erdgas' as energietraeger, count(*) as teilnetze, avg(\"EFH in ct/kWh (brutto) EFH in ct/kWh = Einfamilienhaus Abnahmef\") as preis from fernwaerme_preisuebersicht.fernwaerme_preisuebersicht where ('$bundesland'='Alle' or \"Bundesland\"='$bundesland') and \"Energie­träger Eingesetzte Energieträger in der Erzeugung\" ilike '%Erdgas%' union all select 'Biomasse/Biogas/Biomethan' as energietraeger, count(*) as teilnetze, avg(\"EFH in ct/kWh (brutto) EFH in ct/kWh = Einfamilienhaus Abnahmef\") as preis from fernwaerme_preisuebersicht.fernwaerme_preisuebersicht where ('$bundesland'='Alle' or \"Bundesland\"='$bundesland') and \"Energie­träger Eingesetzte Energieträger in der Erzeugung\" ilike '%Bio%' union all select 'Unvermeidbare Abwärme' as energietraeger, count(*) as teilnetze, avg(\"EFH in ct/kWh (brutto) EFH in ct/kWh = Einfamilienhaus Abnahmef\") as preis from fernwaerme_preisuebersicht.fernwaerme_preisuebersicht where ('$bundesland'='Alle' or \"Bundesland\"='$bundesland') and \"Energie­träger Eingesetzte Energieträger in der Erzeugung\" ilike '%Abwärme%' union all select 'Leichtöl' as energietraeger, count(*) as teilnetze, avg(\"EFH in ct/kWh (brutto) EFH in ct/kWh = Einfamilienhaus Abnahmef\") as preis from fernwaerme_preisuebersicht.fernwaerme_preisuebersicht where ('$bundesland'='Alle' or \"Bundesland\"='$bundesland') and \"Energie­träger Eingesetzte Energieträger in der Erzeugung\" ilike '%Leichtöl%' union all select 'Kohle (Stein-/Braunkohle)' as energietraeger, count(*) as teilnetze, avg(\"EFH in ct/kWh (brutto) EFH in ct/kWh = Einfamilienhaus Abnahmef\") as preis from fernwaerme_preisuebersicht.fernwaerme_preisuebersicht where ('$bundesland'='Alle' or \"Bundesland\"='$bundesland') and \"Energie­träger Eingesetzte Energieträger in der Erzeugung\" ilike '%kohle%' union all select 'Abfall' as energietraeger, count(*) as teilnetze, avg(\"EFH in ct/kWh (brutto) EFH in ct/kWh = Einfamilienhaus Abnahmef\") as preis from fernwaerme_preisuebersicht.fernwaerme_preisuebersicht where ('$bundesland'='Alle' or \"Bundesland\"='$bundesland') and \"Energie­träger Eingesetzte Energieträger in der Erzeugung\" ilike '%Abfall%' union all select 'Geothermie' as energietraeger, count(*) as teilnetze, avg(\"EFH in ct/kWh (brutto) EFH in ct/kWh = Einfamilienhaus Abnahmef\") as preis from fernwaerme_preisuebersicht.fernwaerme_preisuebersicht where ('$bundesland'='Alle' or \"Bundesland\"='$bundesland') and \"Energie­träger Eingesetzte Energieträger in der Erzeugung\" ilike '%Geothermie%' union all select 'Sonstige (EE)' as energietraeger, count(*) as teilnetze, avg(\"EFH in ct/kWh (brutto) EFH in ct/kWh = Einfamilienhaus Abnahmef\") as preis from fernwaerme_preisuebersicht.fernwaerme_preisuebersicht where ('$bundesland'='Alle' or \"Bundesland\"='$bundesland') and \"Energie­träger Eingesetzte Energieträger in der Erzeugung\" ilike '%Sonstige (EE)%') x where teilnetze > 0 order by teilnetze desc",
          "refId": "A"
        }
