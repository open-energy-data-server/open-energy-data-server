          "rawQuery": true,
          "rawSql": "select to_char(floor(price_e_kwh/0.05)*0.05, 'FM0.00') as \"ab EUR/kWh\", count(*) as \"Stationen\"\nfrom chargepoint.chargingstations where price_e_kwh > 0 and ('$operator'='Alle' or kunde='$operator') group by floor(price_e_kwh/0.05) order by floor(price_e_kwh/0.05)",
          "refId": "A"
