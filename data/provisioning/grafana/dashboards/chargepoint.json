          "format": "table",
          "rawQuery": true,
          "rawSql": "select lat, lon, price_e_kwh as preis, kunde as betreiber, parking as blockiergebuehr_eur_h from chargepoint.chargingstations where price_e_kwh > 0 and ('$operator'='Alle' or kunde='$operator')",
          "refId": "A"
