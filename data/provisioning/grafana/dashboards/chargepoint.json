          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select case when price_e_kwh < 0.35 then 'bis 0,35' when price_e_kwh < 0.5 then '0,35 - 0,50'\nwhen price_e_kwh < 0.65 then '0,50 - 0,65' else 'über 0,65' end as klasse, count(*) as stationen\nfrom chargepoint.chargingstations where price_e_kwh > 0 and ('$operator'='Alle' or kunde='$operator') group by 1 order by 1",
          "refId": "A"
