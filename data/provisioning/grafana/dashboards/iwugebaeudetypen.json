          "format": "table",
          "rawQuery": true,
          "rawSql": "select case when trim(\"Baualtersklasse\") like '...%' then 'bis ' || trim(replace(\"Baualtersklasse\",'...','')) when trim(\"Baualtersklasse\") like '%...' then 'ab ' || trim(replace(\"Baualtersklasse\",'...','')) else replace(trim(\"Baualtersklasse\"),' ... ','-') end as baualtersklasse,\n100*(1 - avg(\"Nutzwärme_Nettoheizwärmebedarf_kWh_div_(m2a)\") filter (where \"Sanierungsstand\"='Saniert')/avg(\"Nutzwärme_Nettoheizwärmebedarf_kWh_div_(m2a)\") filter (where \"Sanierungsstand\"='Unsaniert')) as \"Saniert (konventionell)\",\n100*(1 - avg(\"Nutzwärme_Nettoheizwärmebedarf_kWh_div_(m2a)\") filter (where \"Sanierungsstand\"='Modern')/avg(\"Nutzwärme_Nettoheizwärmebedarf_kWh_div_(m2a)\") filter (where \"Sanierungsstand\"='Unsaniert')) as \"Modern (zukunftsweisend)\"\nfrom iwugebaeudetypen.\"iwu_typgebäude\" where \"Rechenverfahren\"='$verfahren' and \"Gebäude_typ_klasse\"='$typ' and \"Heiz_klasse\"='$heizung' group by 1 order by min(\"Baualtersklasse_von\")",
