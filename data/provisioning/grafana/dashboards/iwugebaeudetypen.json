    {
      "type": "barchart",
      "title": "Nettoheizwärmebedarf nach Baualtersklasse",
      "description": "Nutzwärme für Heizung in kWh pro m² Wohnfläche und Jahr, Mittelwert über die Gebäudevarianten des gewählten Typs.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select case when trim(\"Baualtersklasse\") like '...%' then 'bis ' || trim(replace(\"Baualtersklasse\",'...','')) when trim(\"Baualtersklasse\") like '%...' then 'ab ' || trim(replace(\"Baualtersklasse\",'...','')) else replace(trim(\"Baualtersklasse\"),' ... ','-') end as baualtersklasse,\navg(\"Nutzwärme_Nettoheizwärmebedarf_kWh_div_(m2a)\") filter (where \"Sanierungsstand\"='Unsaniert') as \"Unsaniert\",\navg(\"Nutzwärme_Nettoheizwärmebedarf_kWh_div_(m2a)\") filter (where \"Sanierungsstand\"='Saniert') as \"Saniert (konventionell)\",\navg(\"Nutzwärme_Nettoheizwärmebedarf_kWh_div_(m2a)\") filter (where \"Sanierungsstand\"='Modern') as \"Modern (zukunftsweisend)\"\nfrom iwugebaeudetypen.\"iwu_typgebäude\" where \"Rechenverfahren\"='$verfahren' and \"Gebäude_typ_klasse\"='$typ' and \"Heiz_klasse\"='$heizung' group by 1 order by min(\"Baualtersklasse_von\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: kWh/m²a",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "gradientMode": "none",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto"
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Unsaniert"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2495C"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Saniert (konventionell)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Modern (zukunftsweisend)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "baualtersklasse",
        "orientation": "vertical",
        "showValue": "never",
        "stacking": "none",
        "barWidth": 0.8,
        "groupWidth": 0.75,
        "xTickLabelRotation": 0,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "id": 7,
