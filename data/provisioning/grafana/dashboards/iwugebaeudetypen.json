    {
      "type": "barchart",
      "title": "Einsparung gegenüber unsaniertem Zustand",
      "description": "Reduktion des Nettoheizwärmebedarfs durch konventionelle Sanierung bzw. zukunftsweisendes Modernisierungspaket, in Prozent des unsanierten Bedarfs.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
