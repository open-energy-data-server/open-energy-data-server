        "definition": "SELECT 'House ' || regexp_replace(house, '\\D', '', 'g') AS __text, house AS __value FROM (SELECT DISTINCT house FROM refit.refit WHERE \"Time\" >= '2014-07-01' AND \"Time\" < '2014-07-02') x ORDER BY regexp_replace(house, '\\D', '', 'g')::int",
