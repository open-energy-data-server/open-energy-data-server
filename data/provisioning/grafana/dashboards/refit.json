    {
      "type": "stat",
      "title": "refit.refit",
      "description": "First and latest timestamp and approximate rows (about 8 s samples, 20 houses, 120 million rows). Static dataset without live updates. Keep the time range to a few weeks.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (extract(epoch from min(\"Time\"))*1000)::bigint as \"First\", (extract(epoch from max(\"Time\"))*1000)::bigint as \"Latest\", approximate_row_count('refit.refit'::regclass) as \"Rows (approx.)\"\nFROM refit.refit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "First"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
