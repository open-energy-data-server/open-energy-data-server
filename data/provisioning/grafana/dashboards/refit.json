    {
      "type": "barchart",
      "title": "Energy per day by house",
      "description": "Mean aggregate power x 24 h per house in the selected range, split into base load (5th percentile power x 24 h) and the remainder. Houses with recording gaps are not corrected.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'House ' || regexp_replace(house, '\\D', '', 'g') AS \"House\", least(percentile_cont(0.05) WITHIN GROUP (ORDER BY \"Aggregate\"), avg(\"Aggregate\"))*24/1000 AS \"Base load\", greatest(avg(\"Aggregate\") - percentile_cont(0.05) WITHIN GROUP (ORDER BY \"Aggregate\"), 0)*24/1000 AS \"Above base load\"\nFROM refit.refit WHERE $__timeFilter(\"Time\") GROUP BY house ORDER BY regexp_replace(house, '\\D', '', 'g')::int"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "gradientMode": "none",
            "axisPlacement": "auto"
          },
          "unit": "suffix: kWh/d"
        },
        "overrides": []
      },
      "options": {
        "xField": "House",
        "orientation": "vertical",
        "xTickLabelRotation": -45,
        "stacking": "normal",
        "showValue": "never",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "barWidth": 0.9,
        "groupWidth": 0.8,
        "fullHighlight": false
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Houses: recording coverage",
      "description": "Samples, first and last sample in the selected range, and coverage = samples x 8 s / range length (the nominal sampling interval is 8 s). Values below ~80 % indicate recording gaps; very low standard deviation indicates a stuck meter.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'House ' || regexp_replace(house, '\\D', '', 'g') AS \"House\", count(*) AS \"Samples\", 100.0*count(*)*8/GREATEST(1, extract(epoch from ($__timeTo()::timestamptz - $__timeFrom()::timestamptz))) AS \"Coverage (%)\", (extract(epoch from min(\"Time\"))*1000)::bigint AS \"First\", (extract(epoch from max(\"Time\"))*1000)::bigint AS \"Last\", avg(\"Aggregate\") AS \"Mean (W)\", stddev(\"Aggregate\") AS \"Std. dev. (W)\", max(\"Aggregate\") AS \"Peak (W)\"\nFROM refit.refit WHERE $__timeFilter(\"Time\") GROUP BY house ORDER BY regexp_replace(house, '\\D', '', 'g')::int"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Samples"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Coverage (%)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "First"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Mean (W)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "watt"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Std. dev. (W)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "watt"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Peak (W)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "watt"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "trend",
      "title": "Mean daily profile of all houses",
      "description": "Mean aggregate power by hour of the day (Europe/London local time) over all houses and the range, weekdays and weekends. Evening peak between 18 and 20 h, a smaller morning peak, and on weekends a later and flatter morning.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT extract(hour from \"Time\" AT TIME ZONE 'Europe/London')::int AS \"Hour\", avg(\"Aggregate\") FILTER (WHERE extract(isodow from \"Time\" AT TIME ZONE 'Europe/London') < 6) AS \"Weekday\", avg(\"Aggregate\") FILTER (WHERE extract(isodow from \"Time\" AT TIME ZONE 'Europe/London') >= 6) AS \"Weekend\"\nFROM refit.refit WHERE $__timeFilter(\"Time\") GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "axisPlacement": "auto",
            "spanNulls": true
          },
          "unit": "watt",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "xField": "Hour",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 8
