          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT c.label AS \"Power class\", 100.0*count(*)/sum(count(*)) OVER () AS \"Share of samples (%)\" FROM (SELECT CASE WHEN \"Aggregate\" < 100 THEN '1: <100 W' WHEN \"Aggregate\" < 200 THEN '2: 100-200 W' WHEN \"Aggregate\" < 300 THEN '3: 200-300 W' WHEN \"Aggregate\" < 500 THEN '4: 300-500 W' WHEN \"Aggregate\" < 1000 THEN '5: 0.5-1 kW' WHEN \"Aggregate\" < 2000 THEN '6: 1-2 kW' WHEN \"Aggregate\" < 3000 THEN '7: 2-3 kW' WHEN \"Aggregate\" < 5000 THEN '8: 3-5 kW' ELSE '9: >5 kW' END AS label FROM refit.refit WHERE $__timeFilter(\"Time\") AND house = '$house') c GROUP BY 1 ORDER BY 1"
        }
