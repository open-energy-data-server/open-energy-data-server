    {
      "type": "stat",
      "title": "$house in the selected range",
      "description": "Mean aggregate power, the energy extrapolated to a day (mean power x 24 h; gaps in the recording are ignored), base load (5th percentile of the aggregate power) and the peak. Appliance names (fridge, washing machine, ...) differ per house and are not stored in the database, only Appliance1..9. ",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg(\"Aggregate\") AS \"Mean power\", avg(\"Aggregate\")*24/1000 AS \"Energy per day\", percentile_cont(0.05) WITHIN GROUP (ORDER BY \"Aggregate\") AS \"Base load\", max(\"Aggregate\") AS \"Peak\", count(*) AS \"Samples\"\nFROM refit.refit WHERE $__timeFilter(\"Time\") AND house = '$house'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Mean power"
            },
            "properties": [
              {
                "id": "unit",
                "value": "watt"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
