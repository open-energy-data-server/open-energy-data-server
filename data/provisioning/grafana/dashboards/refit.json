    {
      "type": "timeseries",
      "title": "Aggregate power",
      "description": "Whole-house power (mean and maximum per time bin, W). Gaps are missing recordings. Sampling is irregular (about 8 s).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(\"Time\",$__interval), avg(\"Aggregate\") AS \"Mean\", max(\"Aggregate\") AS \"Maximum\" FROM refit.refit WHERE $__timeFilter(\"Time\") AND house = '$house' GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "axisPlacement": "auto",
            "gradientMode": "none"
          },
          "unit": "watt",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Appliance power",
      "description": "Mean power of the 9 monitored appliance channels plus the unmonitored remainder (aggregate minus the sum of the channels, at least 0), stacked. Appliance names (fridge, washing machine, ...) differ per house and are not stored in the database, only Appliance1..9. ",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(\"Time\",$__interval), avg(\"Appliance1\") AS \"Appliance1\", avg(\"Appliance2\") AS \"Appliance2\", avg(\"Appliance3\") AS \"Appliance3\", avg(\"Appliance4\") AS \"Appliance4\", avg(\"Appliance5\") AS \"Appliance5\", avg(\"Appliance6\") AS \"Appliance6\", avg(\"Appliance7\") AS \"Appliance7\", avg(\"Appliance8\") AS \"Appliance8\", avg(\"Appliance9\") AS \"Appliance9\", avg(greatest(\"Aggregate\" - (coalesce(\"Appliance1\",0) + coalesce(\"Appliance2\",0) + coalesce(\"Appliance3\",0) + coalesce(\"Appliance4\",0) + coalesce(\"Appliance5\",0) + coalesce(\"Appliance6\",0) + coalesce(\"Appliance7\",0) + coalesce(\"Appliance8\",0) + coalesce(\"Appliance9\",0)), 0)) AS \"Unmonitored\"\nFROM refit.refit WHERE $__timeFilter(\"Time\") AND house = '$house' GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "axisPlacement": "auto",
            "gradientMode": "none",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "watt",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 9
      }
    },
    {
      "type": "barchart",
      "title": "Energy share by channel",
      "description": "Mean energy per day of each appliance channel and the unmonitored remainder in the selected range (kWh/day).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ch AS \"Channel\", v*24/1000 AS \"Energy (kWh/day)\" FROM (SELECT avg(\"Appliance1\") AS a1, avg(\"Appliance2\") AS a2, avg(\"Appliance3\") AS a3, avg(\"Appliance4\") AS a4, avg(\"Appliance5\") AS a5, avg(\"Appliance6\") AS a6, avg(\"Appliance7\") AS a7, avg(\"Appliance8\") AS a8, avg(\"Appliance9\") AS a9, avg(greatest(\"Aggregate\" - (coalesce(\"Appliance1\",0) + coalesce(\"Appliance2\",0) + coalesce(\"Appliance3\",0) + coalesce(\"Appliance4\",0) + coalesce(\"Appliance5\",0) + coalesce(\"Appliance6\",0) + coalesce(\"Appliance7\",0) + coalesce(\"Appliance8\",0) + coalesce(\"Appliance9\",0)), 0)) AS unmon FROM refit.refit WHERE $__timeFilter(\"Time\") AND house = '$house') s, LATERAL (VALUES ('Appliance 1', a1), ('Appliance 2', a2), ('Appliance 3', a3), ('Appliance 4', a4), ('Appliance 5', a5), ('Appliance 6', a6), ('Appliance 7', a7), ('Appliance 8', a8), ('Appliance 9', a9), ('Unmonitored', unmon)) AS u(ch, v) ORDER BY ch"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "gradientMode": "none",
            "axisPlacement": "auto"
          },
          "unit": "suffix: kWh/d"
        },
        "overrides": []
      },
      "options": {
        "xField": "Channel",
        "orientation": "vertical",
        "xTickLabelRotation": -45,
        "stacking": "none",
        "showValue": "never",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "barWidth": 0.9,
        "groupWidth": 0.8,
        "fullHighlight": false
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "trend",
      "title": "Typical day by weekday / weekend",
      "description": "Mean aggregate power of the selected house by hour of the day (Europe/London) on weekdays and weekends.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT extract(hour from \"Time\" AT TIME ZONE 'Europe/London')::int AS \"Hour\", avg(\"Aggregate\") FILTER (WHERE extract(isodow from \"Time\" AT TIME ZONE 'Europe/London') < 6) AS \"Weekday\", avg(\"Aggregate\") FILTER (WHERE extract(isodow from \"Time\" AT TIME ZONE 'Europe/London') >= 6) AS \"Weekend\"\nFROM refit.refit WHERE $__timeFilter(\"Time\") AND house = '$house' GROUP BY 1 ORDER BY 1"
        }
