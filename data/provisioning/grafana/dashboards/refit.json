    {
      "type": "barchart",
      "title": "Distribution of the aggregate power of $house",
      "description": "Share of samples per power class, selected house and range. Most of the time the households consume only a few hundred watts; short peaks come from kettles, ovens and showers.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
