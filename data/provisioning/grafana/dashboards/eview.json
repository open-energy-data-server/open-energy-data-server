    {
      "type": "barchart",
      "title": "Output distribution of $plant",
      "description": "Share of reported intervals by output class relative to the peak power of the plant in the range. A PV plant spends many intervals at low output.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
