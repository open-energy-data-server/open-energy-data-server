    },
    {
      "type": "trend",
      "title": "Typical day of $plant (local time)",
      "description": "Mean, 90th percentile and maximum power by hour of day (Europe/Berlin) over the selected range. Hours without reported values (night) are missing.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT extract(hour from datetime AT TIME ZONE 'Europe/Berlin')::int AS \"Hour\", avg(value) AS \"Mean\", percentile_cont(0.9) WITHIN GROUP (ORDER BY value) AS \"P90\", max(value) AS \"Max\" FROM eview.eview\nWHERE $__timeFilter(datetime) AND plant_id = '$plant' AND value >= 0 AND value < 1000 GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
