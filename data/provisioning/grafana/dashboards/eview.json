          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH s AS (SELECT value, max(value) OVER () AS m FROM eview.eview WHERE $__timeFilter(datetime) AND plant_id = '$plant' AND value >= 0 AND value < 1000)\nSELECT lpad((least(floor(value/NULLIF(m,0)*10),9)*10)::int::text, 2, '0') || '-' || ((least(floor(value/NULLIF(m,0)*10),9)+1)*10)::int || ' %' AS \"Output class (% of peak)\", count(*)*100.0/sum(count(*)) OVER () AS \"Share of intervals (%)\" FROM s WHERE m > 0 GROUP BY 1 ORDER BY 1"
