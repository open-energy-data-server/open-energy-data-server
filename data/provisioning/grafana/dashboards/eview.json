    },
    {
      "type": "timeseries",
      "title": "Power of $plant",
      "description": "15 minute power of the selected plant. Night values are mostly not delivered by the source (gaps instead of zeros). Values outside 0..1000 kW are dropped: the source contains sentinel values (about 4.29 million, an unsigned overflow) and some plants switch to a constant meter-like reading (e.g. SCHULZEN 2025-02-17 onward ~14000). ",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(datetime,$__interval), avg(value) AS \"Power\", max(value) AS \"Max in bin\" FROM eview.eview\nWHERE $__timeFilter(datetime) AND plant_id = '$plant' AND value >= 0 AND value < 1000 GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "axisPlacement": "auto",
            "gradientMode": "none"
          },
          "unit": "kwatt"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 16,
        "h": 8
      }
    },
    {
      "type": "barchart",
      "title": "Daily energy of $plant",
      "description": "Energy per day (value x 0.25 h). Days with source gaps appear too low.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(day, 'YYYY-MM-DD') AS \"Day\", e AS \"Energy (kWh)\" FROM (SELECT date_trunc('day', datetime) AS day, sum(value)*0.25 AS e FROM eview.eview WHERE $__timeFilter(datetime) AND plant_id = '$plant' AND value >= 0 AND value < 1000 GROUP BY 1) x ORDER BY day"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "gradientMode": "none",
            "axisPlacement": "auto"
          },
          "unit": "kwatth"
        },
        "overrides": []
      },
      "options": {
        "xField": "Day",
        "orientation": "vertical",
        "xTickLabelRotation": -45,
        "stacking": "none",
        "showValue": "never",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
