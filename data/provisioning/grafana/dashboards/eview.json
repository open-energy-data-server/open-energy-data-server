    {
      "type": "timeseries",
      "title": "PV fleet output",
      "description": "Sum over all plants of the mean 15 minute power per time bin. The sum drops when plants stop reporting or have gaps, so read it together with the number of reporting plants. Values outside 0..1000 kW are dropped: the source contains sentinel values (about 4.29 million, an unsigned overflow) and some plants switch to a constant meter-like reading (e.g. SCHULZEN 2025-02-17 onward ~14000). Unit kW as delivered by the source.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, sum(v) AS \"Fleet output\"\nFROM (SELECT $__timeGroupAlias(datetime,$__interval), plant_id, avg(value) AS v FROM eview.eview\n  WHERE $__timeFilter(datetime) AND value >= 0 AND value < 1000 GROUP BY 1,2) x\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "axisPlacement": "auto",
            "gradientMode": "none"
          },
          "unit": "kwatt"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 16,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Reporting plants per day",
      "description": "Number of plants with at least one valid value per day. The source has gaps; dips are outages of the portal or of single plants.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(datetime,'1d'), count(DISTINCT plant_id) AS \"Plants reporting\" FROM eview.eview\nWHERE $__timeFilter(datetime) AND value >= 0 AND value < 1000 GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "axisPlacement": "auto",
            "gradientMode": "none"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Daily fleet energy",
      "description": "Daily energy of all plants, assuming each value is the mean power (kW) of its 15 minute interval (energy = value x 0.25 h).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(datetime,'1d'), sum(value)*0.25/1000 AS \"Energy\" FROM eview.eview\nWHERE $__timeFilter(datetime) AND value >= 0 AND value < 1000 GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "axisPlacement": "auto",
            "gradientMode": "none"
          },
          "unit": "MWh"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "barchart",
      "title": "Top 15 plants by energy",
      "description": "Energy per plant in the selected time range (value x 0.25 h). Plants with gaps rank lower.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT plant AS \"Plant\", sum(value)*0.25/1000 AS \"Energy (MWh)\" FROM eview.eview\nWHERE $__timeFilter(datetime) AND value >= 0 AND value < 1000 GROUP BY plant ORDER BY 2 DESC LIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "gradientMode": "none",
            "axisPlacement": "auto"
          },
          "unit": "MWh"
        },
        "overrides": []
      },
      "options": {
        "xField": "Plant",
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "stacking": "none",
        "showValue": "never",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "barWidth": 0.9,
        "groupWidth": 0.8,
        "fullHighlight": false
      },
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Plants in the selected range",
      "description": "Per plant: last value, peak power and energy in the time range, and the number of days with data.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT plant AS \"Plant\", plant_id AS \"Id\", (extract(epoch from max(datetime))*1000)::bigint AS \"Last value\", max(value) AS \"Peak (kW)\", sum(value)*0.25/1000 AS \"Energy (MWh)\", count(DISTINCT date_trunc('day', datetime)) AS \"Days with data\"\nFROM eview.eview WHERE $__timeFilter(datetime) AND value >= 0 AND value < 1000 GROUP BY 1,2 ORDER BY 5 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last value"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Peak (kW)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "kwatt"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Energy (MWh)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "MWh"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Plants that stopped reporting",
      "description": "Plants whose newest value is more than 30 days old (whole history).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT max(plant) AS \"Plant\", plant_id AS \"Id\", (extract(epoch from min(datetime))*1000)::bigint AS \"First value\", (extract(epoch from max(datetime))*1000)::bigint AS \"Last value\"\nFROM eview.eview GROUP BY plant_id HAVING max(datetime) < now() - interval '30 days' ORDER BY 4 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "First value"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last value"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 10,
