    {
      "type": "piechart",
      "title": "Stromverbrauch nach Sektor",
      "description": "Jahresverbrauch nach Sektor in der gewählten Version (TWh).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select 'Haushalte' as sektor, sum(sector_consumption_residential)/1000 as twh from oep.ego_demand where version='$version'\nunion all select 'Gewerbe/Handel/Dienstleistung', sum(sector_consumption_retail)/1000 from oep.ego_demand where version='$version'\nunion all select 'Industrie', sum(sector_consumption_industrial)/1000 from oep.ego_demand where version='$version'\nunion all select 'Landwirtschaft', sum(sector_consumption_agricultural)/1000 from oep.ego_demand where version='$version'",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: TWh",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Haushalte"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Gewerbe/Handel/Dienstleistung"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Industrie"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Landwirtschaft"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B877D9"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "pieType": "donut",
        "displayLabels": [
          "percent"
