    {
      "type": "geomap",
      "title": "Stromverbrauch je NUTS3-Region",
      "description": "Kreise (NUTS3) mit Jahresverbrauch in GWh (Größe) und Anteil der Industrie (Farbe, %). Position ist der Mittelwert der PLZ-Mittelpunkte der Region.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
