          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select case left(nuts,3) when 'DE1' then 'Baden-Württemberg' when 'DE2' then 'Bayern' when 'DE3' then 'Berlin' when 'DE4' then 'Brandenburg'\nwhen 'DE5' then 'Bremen' when 'DE6' then 'Hamburg' when 'DE7' then 'Hessen' when 'DE8' then 'Mecklenburg-Vorpommern' when 'DE9' then 'Niedersachsen'\nwhen 'DEA' then 'Nordrhein-Westfalen' when 'DEB' then 'Rheinland-Pfalz' when 'DEC' then 'Saarland' when 'DED' then 'Sachsen' when 'DEE' then 'Sachsen-Anhalt'\nwhen 'DEF' then 'Schleswig-Holstein' when 'DEG' then 'Thüringen' else left(nuts,3) end as bundesland, 100*sum(sector_consumption_industrial)/nullif(sum(sector_consumption_sum),0) as \"Industrieanteil\"\nfrom oep.ego_demand where version='$version' group by 1 order by 2 desc",
          "refId": "A"
