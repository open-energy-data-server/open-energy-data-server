    {
      "type": "barchart",
      "title": "Stromverbrauch je Bundesland und Sektor",
      "description": "Jahresverbrauch in TWh, NUTS1-Region aus dem NUTS-Code der Lastgebiete.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select case left(nuts,3) when 'DE1' then 'Baden-Württemberg' when 'DE2' then 'Bayern' when 'DE3' then 'Berlin' when 'DE4' then 'Brandenburg'\nwhen 'DE5' then 'Bremen' when 'DE6' then 'Hamburg' when 'DE7' then 'Hessen' when 'DE8' then 'Mecklenburg-Vorpommern' when 'DE9' then 'Niedersachsen'\nwhen 'DEA' then 'Nordrhein-Westfalen' when 'DEB' then 'Rheinland-Pfalz' when 'DEC' then 'Saarland' when 'DED' then 'Sachsen' when 'DEE' then 'Sachsen-Anhalt'\nwhen 'DEF' then 'Schleswig-Holstein' when 'DEG' then 'Thüringen' else left(nuts,3) end as bundesland, sum(sector_consumption_residential)/1000 as \"Haushalte\", sum(sector_consumption_retail)/1000 as \"Gewerbe/Handel/Dienstleistung\",\nsum(sector_consumption_industrial)/1000 as \"Industrie\", sum(sector_consumption_agricultural)/1000 as \"Landwirtschaft\"\nfrom oep.ego_demand where version='$version' group by 1 order by sum(sector_consumption_sum) desc",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: TWh",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "gradientMode": "none",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisPlacement": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Haushalte"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Gewerbe/Handel/Dienstleistung"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Industrie"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Landwirtschaft"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B877D9"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "bundesland",
        "orientation": "vertical",
        "showValue": "never",
        "stacking": "normal",
        "barWidth": 0.8,
        "groupWidth": 0.75,
        "xTickLabelRotation": -45,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
