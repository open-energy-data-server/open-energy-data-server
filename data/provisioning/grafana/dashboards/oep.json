    {
      "type": "barchart",
      "title": "Haushaltsstrom pro Einwohner",
      "description": "Verbrauch der Haushalte in kWh pro Einwohner und Jahr je Bundesland (sector_consumption_residential / zensus_sum).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select case left(nuts,3) when 'DE1' then 'Baden-Württemberg' when 'DE2' then 'Bayern' when 'DE3' then 'Berlin' when 'DE4' then 'Brandenburg'\nwhen 'DE5' then 'Bremen' when 'DE6' then 'Hamburg' when 'DE7' then 'Hessen' when 'DE8' then 'Mecklenburg-Vorpommern' when 'DE9' then 'Niedersachsen'\nwhen 'DEA' then 'Nordrhein-Westfalen' when 'DEB' then 'Rheinland-Pfalz' when 'DEC' then 'Saarland' when 'DED' then 'Sachsen' when 'DEE' then 'Sachsen-Anhalt'\nwhen 'DEF' then 'Schleswig-Holstein' when 'DEG' then 'Thüringen' else left(nuts,3) end as bundesland, sum(sector_consumption_residential)*1e6/nullif(sum(zensus_sum),0) as \"kWh/Einwohner\"\nfrom oep.ego_demand where version='$version' group by 1 order by 2 desc",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: kWh",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "gradientMode": "none",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "xField": "bundesland",
        "orientation": "vertical",
        "showValue": "never",
        "stacking": "none",
        "barWidth": 0.8,
        "groupWidth": 0.75,
        "xTickLabelRotation": -45,
        "legend": {
