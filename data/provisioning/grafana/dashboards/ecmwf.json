    {
      "type": "timeseries",
      "title": "Air temperature in $nuts",
      "description": "Hourly 2 m air temperature of the selected region with the daily minimum and maximum.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(\"time\", $__interval), avg(temp_air - 273.15) AS \"temperature\" FROM ecmwf.ecmwf_eu\nWHERE $__timeFilter(\"time\") AND nuts_id = '${nuts}' GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
