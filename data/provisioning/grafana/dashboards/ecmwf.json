      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', \"time\") AS time, sum(greatest(18 - t, 0)) / 24 AS \"heating degree days (base 18 degC)\", sum(g) / 3.6e6 AS \"solar kWh/m2\"\nFROM (SELECT \"time\", avg(temp_air - 273.15) AS t, avg(ghi) AS g FROM ecmwf.ecmwf_eu WHERE $__timeFilter(\"time\") AND nuts_id = '${nuts}' GROUP BY 1) h\nGROUP BY 1 ORDER BY 1"
        }
      ],
