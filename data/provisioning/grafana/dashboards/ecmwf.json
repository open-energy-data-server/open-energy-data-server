    {
      "type": "geomap",
      "title": "NUTS-2 map of $map_metric",
      "description": "Selected weather variable per NUTS-2 region at the latest hour of the range (temp_air in degC, wind_speed in m/s, ghi in W/m2, precipitation in mm). Change the metric with the variable at the top. Markers are placed at the region centre.",
      "datasource": {
