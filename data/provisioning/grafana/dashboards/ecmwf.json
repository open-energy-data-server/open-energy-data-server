          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg(temp_air - 273.15) AS \"temperature\" FROM ecmwf.ecmwf_eu WHERE \"time\" = (SELECT max(\"time\") FROM ecmwf.ecmwf_eu WHERE $__timeFilter(\"time\")) AND length(nuts_id) = 2"
