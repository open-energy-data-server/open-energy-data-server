      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.nuts_id, n.nuts_name AS region, e.latitude AS lat, e.longitude AS lon,\n  CASE '${map_metric}' WHEN 'temp_air' THEN temp_air - 273.15 WHEN 'wind_speed' THEN wind_speed\n       WHEN 'ghi' THEN ghi / 3600 WHEN 'precipitation' THEN precipitation * 1000 END AS value\nFROM ecmwf.ecmwf_eu e LEFT JOIN public.nuts n USING (nuts_id)\nWHERE e.\"time\" = (SELECT max(\"time\") FROM ecmwf.ecmwf_eu WHERE $__timeFilter(\"time\")) AND length(e.nuts_id) = 4"
        }
      ],
