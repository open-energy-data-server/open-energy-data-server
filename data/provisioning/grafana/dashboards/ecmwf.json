    {
      "type": "timeseries",
      "title": "Heating degree days and daily solar yield in $nuts",
      "description": "Heating degree days (base 18 degC, sum of hourly deficit / 24, left) are a proxy for heating energy demand; daily global horizontal irradiation in kWh/m2 (right) is a proxy for PV yield.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
