          "rawSql": "SELECT $__timeGroupAlias(\"time\", $__interval), avg(rain_con) AS \"convective\", avg(rain_gsp) AS \"grid-scale\", avg(cloud_cover) AS \"cloud cover\" FROM dwd.cosmo\nWHERE $__timeFilter(\"time\") AND nuts = '${nuts}' GROUP BY 1 ORDER BY 1"
