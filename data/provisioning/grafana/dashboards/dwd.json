    },
    {
      "type": "timeseries",
      "title": "Precipitation and cloud cover in $nuts",
      "description": "Convective plus grid-scale precipitation (mm, stacked bars, left) and total cloud cover (right).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
