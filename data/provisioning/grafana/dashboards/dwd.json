          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(\"time\", $__interval), avg(ghi) AS \"net short-wave (ghi)\", avg(dni) AS \"dni (diffuse)\", avg(dhi) AS \"dhi (direct)\" FROM dwd.cosmo\nWHERE $__timeFilter(\"time\") AND nuts = '${nuts}' GROUP BY 1 ORDER BY 1"
