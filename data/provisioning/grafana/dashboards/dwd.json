    {
      "type": "timeseries",
      "title": "Monthly mean temperature in $nuts (whole reanalysis)",
      "description": "Monthly means of the selected region; set a wide time range (1995 to 2019) to see the whole record.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
