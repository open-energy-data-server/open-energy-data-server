        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "id": 22
    },
    {
      "type": "timeseries",
      "title": "Solar radiation in $nuts",
      "description": "Short-wave radiation at the surface (W/m2): net balance (`ghi`), diffuse and direct components as stored by the crawler.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
