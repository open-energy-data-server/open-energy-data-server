          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('month', \"time\") AS time, avg(temp_air - 273.15) AS \"monthly mean temperature\" FROM dwd.cosmo\nWHERE $__timeFilter(\"time\") AND nuts = '${nuts}' GROUP BY 1 ORDER BY 1"
