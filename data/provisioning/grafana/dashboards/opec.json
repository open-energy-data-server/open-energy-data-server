{
  "uid": "oeds-opec",
  "title": "OEDS OPEC Crude Oil Price",
  "tags": [
    "oeds",
    "fuels",
    "prices",
    "opec"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "",
  "schemaVersion": 39,
  "version": 1,
  "description": "OPEC reference basket crude oil price in USD and EUR per barrel, with Yahoo Finance Brent as cross-check.",
  "time": {
    "from": "now-5y",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Data status",
      "collapsed": false,
      "panels": [],
      "id": 20,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "table",
      "title": "Data status",
      "description": "First and latest timestamp per table, age of the latest value and approximate row count. Status compares the age with the update cadence of the source: OK within the expected age, LATE up to 3x, STALE beyond; 'static' tables are not updated any more.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'opec.opec' AS \"Table\", min(date)::timestamptz AS \"First\", max(date)::timestamptz AS \"Latest\", round((extract(epoch FROM now() - (max(date)::timestamptz + interval '1 day'))/3600)::numeric, 1) AS \"Age (h)\", approximate_row_count('opec.opec'::regclass) AS \"Rows (approx.)\", 96 AS \"Expected max age (h)\", CASE WHEN extract(epoch FROM now() - (max(date)::timestamptz + interval '1 day'))/3600 <= 96 THEN 'OK' WHEN extract(epoch FROM now() - (max(date)::timestamptz + interval '1 day'))/3600 <= 288 THEN 'LATE' ELSE 'STALE' END AS \"Status\" FROM opec.opec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "OK": {
                        "color": "green",
                        "text": "OK",
                        "index": 0
                      },
                      "LATE": {
                        "color": "orange",
                        "text": "LATE",
                        "index": 1
                      },
                      "STALE": {
                        "color": "red",
                        "text": "STALE",
                        "index": 2
                      },
                      "static": {
                        "color": "blue",
                        "text": "static",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Age (h)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "h"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Rows (approx.)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "First"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Latest"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 14,
        "h": 4
      },
      "id": 21
    },
    {
      "type": "text",
      "title": "Source stopped",
      "datasource": null,
      "options": {
        "mode": "markdown",
        "content": "**No data after 2026-02-23.** The OPEC page is behind a Cloudflare challenge that the crawler cannot pass, so the series ends there and the status above shows STALE. The panels show the available history.\n\n`usd_per_barrel` is the OPEC reference basket, `yahoo_usd_per_barrel` Brent futures from Yahoo Finance; EUR values use the daily exchange rate `usd_eur` (EUR per USD)."
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "x": 14,
        "y": 1,
        "w": 10,
        "h": 4
      },
      "id": 22
    },
