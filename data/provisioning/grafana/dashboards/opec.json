          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT extract(year FROM date)::int AS \"Year\", round(avg(usd_per_barrel)::numeric, 1) AS \"OPEC USD/bbl\",\n  round(avg(yahoo_usd_per_barrel)::numeric, 1) AS \"Brent USD/bbl\", round(avg(euro_per_barrel)::numeric, 1) AS \"OPEC EUR/bbl\",\n  round(min(usd_per_barrel)::numeric, 1) AS \"min USD\", round(max(usd_per_barrel)::numeric, 1) AS \"max USD\"\nFROM opec.opec GROUP BY 1 ORDER BY 1 DESC"
        }
