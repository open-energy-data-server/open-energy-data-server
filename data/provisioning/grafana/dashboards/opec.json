    {
      "type": "timeseries",
      "title": "Oil vs gas price on an energy basis",
      "description": "Oil (OPEC basket, EUR per MWh of oil energy) against the Polish TGE day-ahead gas price (EUR per MWh gas). Shows the oil-to-gas price ratio that drives fuel switching in industry and heating. Cross-source panel: opec x instrat_pl.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(o.date, $__interval), avg(o.euro_per_kwh * 1000) AS \"oil\", avg(g.price_eur_per_mwh) AS \"gas (TGE)\"\nFROM opec.opec o JOIN instrat_pl.gas_price g ON g.date = o.date WHERE $__timeFilter(o.date) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "fillOpacity": 10,
            "pointSize": 4,
            "axisPlacement": "auto"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "suffix: €/MWh"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
