    {
      "type": "timeseries",
      "title": "Crude oil price in USD",
      "description": "OPEC reference basket versus Brent futures (Yahoo Finance), USD per barrel.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(date, $__interval), avg(usd_per_barrel) AS \"OPEC basket\", avg(yahoo_usd_per_barrel) AS \"Brent (Yahoo)\"\nFROM opec.opec WHERE $__timeFilter(date) GROUP BY 1 ORDER BY 1"
        }
      ],
