      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "id": 32
    },
    {
      "type": "table",
      "title": "Yearly averages",
      "description": "Annual mean OPEC basket price (2026 partial).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
