      "id": 26
    },
    {
      "type": "stat",
      "title": "30-day change",
      "description": "Change versus 30 days before the last quote.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (a.usd_per_barrel / b.usd_per_barrel - 1) * 100 AS \"change\" FROM (SELECT * FROM opec.opec ORDER BY date DESC LIMIT 1) a,\nLATERAL (SELECT usd_per_barrel FROM opec.opec WHERE date <= a.date - interval '30 days' ORDER BY date DESC LIMIT 1) b"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
