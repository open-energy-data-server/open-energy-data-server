    {
      "type": "barchart",
      "title": "Steckertypen",
      "description": "Anzahl der Steckverbindungen je Typ (bis zu 6 Steckertypen pro Ladeeinrichtung).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select trim(t) as steckertyp, count(*) as anzahl from ladesaeulenregister.ladesaeulenregister cross join lateral\nunnest(string_to_array(concat_ws(';',\"Steckertypen1\",\"Steckertypen2\",\"Steckertypen3\",\"Steckertypen4\",\"Steckertypen5\",\"Steckertypen6\"),';')) t where ('$bundesland'='Alle' or \"Bundesland\"='$bundesland') and ('$art'='Alle' or \"Art der Ladeeinrichtung\"='$art') and trim(t) <> '' group by 1 order by 2 desc limit 10",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "gradientMode": "none",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
