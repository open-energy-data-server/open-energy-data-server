    {
      "type": "timeseries",
      "title": "Installierte Ladeleistung (kumuliert)",
      "description": "Kumulierte Nennleistung der in Betrieb genommenen Ladeeinrichtungen im aktuellen Register (später stillgelegte Einrichtungen fehlen, daher ist der Verlauf eine Untergrenze).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select time, metric, sum(kw) over (partition by metric order by time)/1000 as v from (\nselect date_trunc('month', to_date(\"Inbetriebnahmedatum\",'DD.MM.YYYY')::timestamp) as time, \"Art der Ladeeinrichtung\" as metric, sum(\"Nennleistung Ladeeinrichtung [kW]\") as kw\nfrom ladesaeulenregister.ladesaeulenregister where to_date(\"Inbetriebnahmedatum\",'DD.MM.YYYY') is not null and ('$bundesland'='Alle' or \"Bundesland\"='$bundesland') and ('$art'='Alle' or \"Art der Ladeeinrichtung\"='$art') group by 1,2) x\nwhere $__timeFilter(time) order by 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: MW",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "auto",
            "spanNulls": true,
            "axisLabel": "",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Normalladeeinrichtung"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Schnellladeeinrichtung"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF780A"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
