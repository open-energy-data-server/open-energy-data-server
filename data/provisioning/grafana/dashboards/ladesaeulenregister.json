          "rawQuery": true,
          "rawSql": "select sum(\"Nennleistung Ladeeinrichtung [kW]\")/1e6 as gw from ladesaeulenregister.ladesaeulenregister where ('$bundesland'='Alle' or \"Bundesland\"='$bundesland') and ('$art'='Alle' or \"Art der Ladeeinrichtung\"='$art')",
