    {
      "type": "stat",
      "title": "Anteil Schnelllader",
      "description": "Anteil der Ladepunkte an Schnellladeeinrichtungen (DC).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
