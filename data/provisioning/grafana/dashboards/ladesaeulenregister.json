    {
      "type": "barchart",
      "title": "Ladeeinrichtungen nach Leistungsklasse",
      "description": "Anzahl Ladeeinrichtungen nach Nennleistung. 11 und 22 kW sind klassische AC-Ladepunkte, ab 50 kW beginnt DC-Schnellladen, ab 150 kW HPC.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select case b when 1 then '1) bis 3,7 kW' when 2 then '2) bis 11 kW' when 3 then '3) bis 22 kW' when 4 then '4) bis 50 kW'\nwhen 5 then '5) bis 150 kW' when 6 then '6) bis 300 kW' else '7) über 300 kW' end as leistungsklasse, count(*) as \"Ladeeinrichtungen\"\nfrom (select width_bucket(\"Nennleistung Ladeeinrichtung [kW]\", array[0,3.7,11.1,22.1,50.1,150,300]) b from ladesaeulenregister.ladesaeulenregister where ('$bundesland'='Alle' or \"Bundesland\"='$bundesland') and ('$art'='Alle' or \"Art der Ladeeinrichtung\"='$art')) x group by b order by b",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "gradientMode": "none",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "leistungsklasse",
        "orientation": "vertical",
        "showValue": "auto",
        "stacking": "none",
        "barWidth": 0.8,
        "groupWidth": 0.75,
        "xTickLabelRotation": 0,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 15
      }
