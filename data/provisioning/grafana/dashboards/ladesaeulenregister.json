    {
      "type": "timeseries",
      "title": "Neue Ladepunkte pro Jahr",
      "description": "Inbetriebnahmen pro Jahr, Summe der Ladepunkte nach Art der Ladeeinrichtung. Zeitraum ueber die Zeitauswahl oben.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select date_trunc('year', to_date(\"Inbetriebnahmedatum\",'DD.MM.YYYY')::timestamp) as time, \"Art der Ladeeinrichtung\" as metric, sum(\"Anzahl Ladepunkte\") as v\nfrom ladesaeulenregister.ladesaeulenregister where to_date(\"Inbetriebnahmedatum\",'DD.MM.YYYY') between $__timeFrom() and $__timeTo() and ('$bundesland'='Alle' or \"Bundesland\"='$bundesland') and ('$art'='Alle' or \"Art der Ladeeinrichtung\"='$art') group by 1,2 order by 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "auto",
            "spanNulls": true,
            "axisLabel": "",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Normalladeeinrichtung"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Schnellladeeinrichtung"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF780A"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
