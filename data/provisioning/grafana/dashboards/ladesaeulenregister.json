          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select 100.0*sum(\"Anzahl Ladepunkte\") filter (where \"Art der Ladeeinrichtung\"='Schnellladeeinrichtung')/nullif(sum(\"Anzahl Ladepunkte\"),0) as p from ladesaeulenregister.ladesaeulenregister where ('$bundesland'='Alle' or \"Bundesland\"='$bundesland') and ('$art'='Alle' or \"Art der Ladeeinrichtung\"='$art')",
