          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select count(*) as n from ladesaeulenregister.ladesaeulenregister where ('$bundesland'='Alle' or \"Bundesland\"='$bundesland') and ('$art'='Alle' or \"Art der Ladeeinrichtung\"='$art')",
