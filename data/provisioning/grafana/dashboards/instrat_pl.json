    {
      "type": "timeseries",
      "title": "Marginal generation cost: gas CCGT vs hard-coal plant",
      "description": "Fuel plus CO2 cost per MWh electricity. Assumptions: gas plant efficiency 55 %, emission factor 0.202 tCO2/MWh gas heat; coal plant efficiency 38 %, emission factor 0.341 tCO2/MWh coal heat. cost = fuel price / efficiency + emission factor / efficiency x EUA price. The cheaper technology is dispatched first (fuel switching). Coal is monthly and ends Feb 2026.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(g.date, $__interval),\n  avg(g.price_eur_per_mwh / 0.55 + 0.202 / 0.55 * e.eur_per_tco2) AS \"gas CCGT\",\n  avg(c.price_eur_per_kwh * 1000 / 0.38 + 0.341 / 0.38 * e.eur_per_tco2) AS \"hard coal\"\nFROM instrat_pl.gas_price g\nJOIN instrat_pl.eu_ets e ON e.date = g.date AND e.indeks = 't3pa'\nJOIN instrat_pl.coal_price c ON c.date = date_trunc('month', g.date)\nWHERE $__timeFilter(g.date) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "fillOpacity": 10,
            "pointSize": 4,
            "axisPlacement": "auto"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "suffix: €/MWh_el"
        },
        "overrides": []
