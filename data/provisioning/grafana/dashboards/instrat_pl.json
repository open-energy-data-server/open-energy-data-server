          "rawSql": "SELECT $__timeGroupAlias(date, $__interval), avg(volume) AS \"volume\" FROM instrat_pl.eu_ets\nWHERE $__timeFilter(date) AND indeks = 't3pa' GROUP BY 1 ORDER BY 1"
        }
