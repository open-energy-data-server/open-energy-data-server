    {
      "type": "timeseries",
      "title": "EU ETS carbon price and traded volume",
      "description": "EU emission allowance price in EUR per tonne CO2 (left) with traded volume (right, bars). The two index series are drawn separately where they overlap (2012-2013).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
