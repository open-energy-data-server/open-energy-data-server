    {
      "type": "table",
      "title": "Yearly averages",
      "description": "Annual mean prices: EUA (EUR/tCO2), TGE gas (EUR/MWh), coal (EUR/MWh thermal; 2026 covers Jan-Feb only).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
