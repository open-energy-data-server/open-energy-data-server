          "rawSql": "SELECT $__timeGroupAlias(g.date, $__interval),\n  avg(0.202 / 0.55 * e.eur_per_tco2 / (g.price_eur_per_mwh / 0.55 + 0.202 / 0.55 * e.eur_per_tco2)) * 100 AS \"gas CCGT\",\n  avg(0.341 / 0.38 * e.eur_per_tco2 / (c.price_eur_per_kwh * 1000 / 0.38 + 0.341 / 0.38 * e.eur_per_tco2)) * 100 AS \"hard coal\"\nFROM instrat_pl.gas_price g\nJOIN instrat_pl.eu_ets e ON e.date = g.date AND e.indeks = 't3pa'\nJOIN instrat_pl.coal_price c ON c.date = date_trunc('month', g.date)\nWHERE $__timeFilter(g.date) GROUP BY 1 ORDER BY 1"
