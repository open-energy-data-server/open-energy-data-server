    {
      "type": "stat",
      "title": "EU ETS 30-day change",
      "description": "Change of the EUA price versus 30 days before the latest quote.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (a.eur_per_tco2 / b.eur_per_tco2 - 1) * 100 AS \"change\" FROM\n(SELECT * FROM instrat_pl.eu_ets WHERE indeks = 't3pa' ORDER BY date DESC LIMIT 1) a,\nLATERAL (SELECT eur_per_tco2 FROM instrat_pl.eu_ets WHERE indeks = 't3pa' AND date <= a.date - interval '30 days' ORDER BY date DESC LIMIT 1) b"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
