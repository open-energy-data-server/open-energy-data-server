    {
      "type": "timeseries",
      "title": "Fuel price per MWh thermal: gas vs coal",
      "description": "Gas and coal on a common basis (EUR per MWh of fuel heat). Coal is monthly (held for the whole month) and therefore ends Feb 2026.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
