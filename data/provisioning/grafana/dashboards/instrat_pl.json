          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(date, $__interval), indeks AS metric, avg(eur_per_tco2) AS \"price\" FROM instrat_pl.eu_ets\nWHERE $__timeFilter(date) GROUP BY 1, 2 ORDER BY 1"
        },
