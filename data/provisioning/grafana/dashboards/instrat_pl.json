          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(g.date, $__interval), avg(g.price_eur_per_mwh) AS \"gas\", avg(c.price_eur_per_kwh * 1000) AS \"coal\"\nFROM instrat_pl.gas_price g JOIN instrat_pl.coal_price c ON c.date = date_trunc('month', g.date)\nWHERE $__timeFilter(g.date) GROUP BY 1 ORDER BY 1"
        }
