          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT y AS \"Year\", round(max(e)::numeric, 1) AS \"EUA (EUR/tCO2)\", round(max(g)::numeric, 1) AS \"Gas (EUR/MWh)\", round(max(c)::numeric, 1) AS \"Coal (EUR/MWh th)\" FROM (\n  SELECT extract(year FROM date)::int AS y, avg(eur_per_tco2) AS e, NULL::float8 AS g, NULL::float8 AS c FROM instrat_pl.eu_ets WHERE indeks = 't3pa' GROUP BY 1\n  UNION ALL SELECT extract(year FROM date)::int, NULL, avg(price_eur_per_mwh), NULL FROM instrat_pl.gas_price GROUP BY 1\n  UNION ALL SELECT extract(year FROM date)::int, NULL, NULL, avg(price_eur_per_kwh * 1000) FROM instrat_pl.coal_price GROUP BY 1) t\nGROUP BY y ORDER BY y DESC"
        }
