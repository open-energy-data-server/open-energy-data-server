    {
      "type": "barchart",
      "title": "Wärmebedarf bis 2045 nach Verwendung",
      "description": "Summe über alle Gebäude in TWh pro Jahr: Raumwärme, Warmwasser und Prozesswärme GHD für heute (Ist) und die Stützjahre des Szenarios. Der Rückgang entsteht durch Sanierung.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select v.jahr, v.rw/1e9 as \"Raumwärme\", v.ww/1e9 as \"Warmwasser\", v.g/1e9 as \"Prozesswärme GHD\" from (select\nsum(\"RW\") as rw0, sum(\"WW\") as ww0, sum(\"GHD_PW\") as g0, sum(\"RW_25\") as rw25, sum(\"WW_25\") as ww25, sum(\"GHD_PW_25\") as g25,\nsum(\"RW_30\") as rw30, sum(\"WW_30\") as ww30, sum(\"GHD_PW_30\") as g30, sum(\"RW_35\") as rw35, sum(\"WW_35\") as ww35, sum(\"GHD_PW_35\") as g35,\nsum(\"RW_40\") as rw40, sum(\"WW_40\") as ww40, sum(\"GHD_PW_40\") as g40, sum(\"RW_45\") as rw45, sum(\"WW_45\") as ww45, sum(\"GHD_PW_45\") as g45 from nrw_kwp_waermedichte.waermedichte) s\ncross join lateral (values ('Ist', s.rw0, s.ww0, s.g0), ('2025', s.rw25, s.ww25, s.g25), ('2030', s.rw30, s.ww30, s.g30), ('2035', s.rw35, s.ww35, s.g35),\n('2040', s.rw40, s.ww40, s.g40), ('2045', s.rw45, s.ww45, s.g45)) v(jahr, rw, ww, g)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: TWh",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "gradientMode": "none",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisPlacement": "auto"
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Raumwärme"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2495C"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Warmwasser"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Prozesswärme GHD"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "jahr",
        "orientation": "vertical",
        "showValue": "never",
        "stacking": "normal",
        "barWidth": 0.8,
        "groupWidth": 0.75,
