        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select case b when 0 then '0) 0' when 1 then '1) bis 500' when 2 then '2) 500-1.000' when 3 then '3) 1.000-1.500' when 4 then '4) 1.500-2.000' when 5 then '5) 2.000-3.000'\nwhen 6 then '6) 3.000-5.000' when 7 then '7) 5.000-10.000' else '8) über 10.000' end as klasse_kwh_pro_m_a, sum(len)/1e3 as \"km Straße\"\nfrom (select width_bucket(\"Waermedichte_RW_WW_GHD_PW\", array[0.0001,500,1000,1500,2000,3000,5000,10000]) as b, \"Strassenlaenge\" as len from nrw_kwp_waermedichte.waermelinien where \"Waermedichte_RW_WW_GHD_PW\" is not null) x\ngroup by b order by b",
          "refId": "A"
        }
