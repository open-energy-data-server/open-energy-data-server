          "rawSql": "SELECT $__timeGroupAlias(timestamp,$__interval), max(value) AS \"High-load window\" FROM vea_industrial_load_profiles.high_load_times WHERE $__timeFilter(timestamp) AND id = $site GROUP BY 1 ORDER BY 1"
