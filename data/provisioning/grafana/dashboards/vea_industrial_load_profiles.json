    },
    {
      "type": "barchart",
      "title": "Mean load per site by sector",
      "description": "Mean load per site (kW) in the selected range by economic sector (WZ 2008 section letter) and the number of sites.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(m.sector_group_id, '?') AS \"Sector\", avg(s.mu) AS \"Mean load per site (kW)\" FROM (SELECT id, avg(value) AS mu FROM vea_industrial_load_profiles.load WHERE $__timeFilter(timestamp) GROUP BY id) s JOIN vea_industrial_load_profiles.master m ON m.id = s.id GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
