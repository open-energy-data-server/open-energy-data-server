          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH s AS (SELECT id, avg(value) AS mu FROM vea_industrial_load_profiles.load WHERE $__timeFilter(timestamp) GROUP BY id HAVING avg(value) > 0)\nSELECT extract(hour from l.timestamp AT TIME ZONE 'Europe/Berlin')::int AS \"Hour\", avg(l.value/s.mu) FILTER (WHERE m.sector_group_id = 'C') AS \"C Manufacturing\", avg(l.value/s.mu) FILTER (WHERE m.sector_group_id = 'G') AS \"G Trade\", avg(l.value/s.mu) FILTER (WHERE m.sector_group_id = 'Q') AS \"Q Health and social\", avg(l.value/s.mu) FILTER (WHERE m.sector_group_id = 'E') AS \"E Water, waste\", avg(l.value/s.mu) FILTER (WHERE m.sector_group_id = 'K') AS \"K Finance\", avg(l.value/s.mu) FILTER (WHERE m.sector_group_id = 'H') AS \"H Transport\"\nFROM vea_industrial_load_profiles.load l JOIN s ON s.id = l.id JOIN vea_industrial_load_profiles.master m ON m.id = l.id WHERE $__timeFilter(l.timestamp) AND extract(isodow from l.timestamp AT TIME ZONE 'Europe/Berlin') >= 6 GROUP BY 1 ORDER BY 1"
