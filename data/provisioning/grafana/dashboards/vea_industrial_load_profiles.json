    {
      "type": "timeseries",
      "title": "Aggregate load of all sites and high-load windows",
      "description": "Sum over all 5,359 sites (MW, left; mean and peak of the quarter hours per bin) and the share of sites that are in a high-load window of their grid operator (right). Sites are charged capacity prices on their peak in these windows, which creates incentives for peak shaving.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(timestamp,$__interval), avg(s) AS \"Mean aggregate load\", max(s) AS \"Peak aggregate load\" FROM (SELECT timestamp, sum(value)/1000 AS s FROM vea_industrial_load_profiles.load WHERE $__timeFilter(timestamp) GROUP BY 1) x GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(timestamp,$__interval), 100*avg(value) AS \"Sites in high-load window\" FROM vea_industrial_load_profiles.high_load_times WHERE $__timeFilter(timestamp) GROUP BY 1 ORDER BY 1"
        }
