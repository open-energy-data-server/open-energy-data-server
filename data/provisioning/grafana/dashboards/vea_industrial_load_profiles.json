    {
      "type": "barchart",
      "title": "Load in high-load windows relative to other times",
      "description": "Mean load during high-load windows divided by the mean load outside, per sector (1 = no reaction). Values below 1 mean the sites reduce load in the windows of the grid operator (peak shaving). Only intervals of the selected range are used, so choose a range with high-load windows (winter weeks).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(m.sector_group_id, '?') AS \"Sector\", avg(l.value) FILTER (WHERE h.value = 1)/NULLIF(avg(l.value) FILTER (WHERE h.value = 0), 0) AS \"Ratio\" FROM vea_industrial_load_profiles.load l JOIN vea_industrial_load_profiles.high_load_times h ON h.id = l.id AND h.timestamp = l.timestamp JOIN vea_industrial_load_profiles.master m ON m.id = l.id WHERE $__timeFilter(l.timestamp) AND $__timeFilter(h.timestamp) GROUP BY 1 ORDER BY 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "gradientMode": "none",
            "axisPlacement": "auto"
          },
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-orange"
          }
        },
        "overrides": []
      },
      "options": {
