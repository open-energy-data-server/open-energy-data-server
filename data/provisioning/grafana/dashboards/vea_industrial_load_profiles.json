          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(timestamp,$__interval), avg(value) AS \"Load\", max(value) AS \"Peak in bin\" FROM vea_industrial_load_profiles.load WHERE $__timeFilter(timestamp) AND id = $site GROUP BY 1 ORDER BY 1"
