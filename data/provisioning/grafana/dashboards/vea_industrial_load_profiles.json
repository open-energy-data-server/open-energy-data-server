        "y": 15,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "trend",
      "title": "Weekend profile by sector (normalised)",
      "description": "Same as the weekday profile, Saturday and Sunday. Office sectors (trade, finance) drop to their base load, continuous manufacturing stays flat.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
