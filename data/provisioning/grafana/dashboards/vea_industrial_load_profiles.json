    {
      "type": "barchart",
      "title": "Load factor distribution",
      "description": "Number of sites per load factor class (mean load / peak load of the site in the selected range). Continuous processes have a high load factor, intermittent sites a low one; the load factor determines the grid fee price band (more or less than 2,500 full-load hours).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT lpad((c*10)::text, 2, '0') || '-' || (c*10+10) || ' %' AS \"Load factor class\", count(*) AS \"Sites\" FROM (SELECT least(floor(100*avg(value)/NULLIF(max(value), 0)/10), 9)::int AS c FROM vea_industrial_load_profiles.load WHERE $__timeFilter(timestamp) GROUP BY id) x WHERE c IS NOT NULL GROUP BY c ORDER BY c"
        }
      ],
      "fieldConfig": {
        "defaults": {
