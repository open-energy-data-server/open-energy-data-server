          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT cntr_code AS country, count(*) FILTER (WHERE levl_code = 1) AS \"NUTS 1\", count(*) FILTER (WHERE levl_code = 2) AS \"NUTS 2\",\n  count(*) FILTER (WHERE levl_code = 3) AS \"NUTS 3\" FROM public.nuts WHERE levl_code > 0 GROUP BY 1 ORDER BY 4 DESC LIMIT 15"
