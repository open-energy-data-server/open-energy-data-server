    {
      "type": "table",
      "title": "Regions of $country",
      "description": "All NUTS 1-3 regions of the selected country with area and Eurostat typology (urbanisation: 1 city, 2 town/suburb, 3 rural; coast: 1 coastal, 2 coastal by population, 3 non-coastal; mountain: 4 = non-mountain).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT nuts_id AS \"NUTS id\", levl_code AS \"Level\", nuts_name AS \"Name\", round((st_area(geometry::geography) / 1e6)::numeric, 0) AS \"Area (km2)\",\n  urbn_type AS \"Urbanisation\", coast_type AS \"Coast\", mount_type AS \"Mountain\"\nFROM public.nuts WHERE cntr_code = '${country}' AND levl_code BETWEEN 1 AND 3 ORDER BY nuts_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
