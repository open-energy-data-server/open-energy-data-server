    {
      "type": "barchart",
      "title": "Districts by degree of urbanisation (NUTS 3, $country)",
      "description": "Number of NUTS 3 districts per urbanisation class.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE urbn_type WHEN 1 THEN '1 city' WHEN 2 THEN '2 town/suburb' WHEN 3 THEN '3 rural' ELSE 'unknown' END AS class, count(*) AS districts\nFROM public.nuts WHERE levl_code = 3 AND cntr_code = '${country}' GROUP BY urbn_type ORDER BY urbn_type"
        }
      ],
