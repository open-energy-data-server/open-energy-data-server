            "attribution": "Tiles © Esri — Esri, HERE, Garmin, © OpenStreetMap contributors"
          }
        },
        "layers": [
          {
            "type": "markers",
            "name": "regions",
            "tooltip": true,
            "filterData": {
              "id": "byRefId",
              "options": "A"
            },
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "config": {
              "showLegend": true,
              "style": {
                "color": {
                  "field": "area (km2)",
                  "fixed": "dark-green"
                },
                "opacity": 0.7,
                "size": {
                  "field": "area (km2)",
                  "fixed": 5,
                  "min": 3,
                  "max": 24
                },
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                },
                "symbolAlign": {
                  "horizontal": "center",
                  "vertical": "center"
                },
                "rotation": {
                  "fixed": 0,
                  "min": -360,
                  "max": 360,
                  "mode": "mod"
                },
                "textConfig": {
                  "fontSize": 12,
                  "offsetX": 0,
                  "offsetY": 0,
                  "textAlign": "center",
                  "textBaseline": "middle"
                }
              }
            }
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      },
      "gridPos": {
        "x": 0,
