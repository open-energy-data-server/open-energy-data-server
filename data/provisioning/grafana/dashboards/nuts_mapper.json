    {
      "type": "table",
      "title": "Table check",
      "description": "public.nuts is a static reference table without time column; checks that every region has geometry, coordinates and valid geometry.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'public.nuts' AS \"Table\", approximate_row_count('public.nuts'::regclass) AS \"Rows (approx.)\", count(*) AS \"Rows\",\n  count(*) FILTER (WHERE geometry IS NULL) AS \"No geometry\", count(*) FILTER (WHERE NOT st_isvalid(geometry)) AS \"Invalid geometry\",\n  count(*) FILTER (WHERE longitude IS NULL OR latitude IS NULL) AS \"No lon/lat\", count(DISTINCT cntr_code) AS \"Countries\", 'static' AS \"Status\"\nFROM public.nuts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "static": {
                        "color": "blue",
                        "text": "static",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "id": 6
    },
    {
      "type": "text",
      "title": "About",
      "datasource": null,
      "options": {
        "mode": "markdown",
        "content": "Reference regions (Eurostat NUTS 2021, EPSG:4326). Other OEDS data (ECMWF weather, energy statistics) is joined to regions through `nuts_id`. Map markers are placed at the centroid of the largest polygon of each region, because the stored `longitude/latitude` of countries with overseas territories (for example France) is pulled into the ocean by the small remote parts."
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 3
      },
      "id": 7
    },
