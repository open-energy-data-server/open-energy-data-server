    {
      "type": "geomap",
      "title": "NUTS level $level regions",
      "description": "Centroid of every region of the chosen NUTS level; marker size shows the area (km2, geodesic), colour the area as well. Choose the level with the variable above.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT nuts_id, nuts_name AS region, cntr_code AS country, st_area(geometry::geography) / 1e6 AS \"area (km2)\",\n  st_y((SELECT st_centroid(g.geom) FROM st_dump(geometry) g ORDER BY st_area(g.geom) DESC LIMIT 1)) AS lat, st_x((SELECT st_centroid(g.geom) FROM st_dump(geometry) g ORDER BY st_area(g.geom) DESC LIMIT 1)) AS lon\nFROM public.nuts WHERE levl_code = ${level}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-BlPu"
          },
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "coords",
          "lat": 52,
          "lon": 12,
          "zoom": 4,
          "allLayers": true
