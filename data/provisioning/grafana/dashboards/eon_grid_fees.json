          "rawQuery": true,
          "rawSql": "select p.latitude as lat, p.longitude as lon, (100000*e.working_price_grid_ct_per_kwh/100.0 + $peak_kw*e.power_price_grid_eur_per_kw + e.fee_measurement_eur_per_year) as netzkosten_eur_a, e.market_partner_name as netzbetreiber, e.working_price_grid_ct_per_kwh as arbeitspreis_ct_kwh, e.power_price_grid_eur_per_kw as leistungspreis_eur_kw from eon_grid_fees.eon_grid_fees e join public.plz p on p.code = e.zip_code",
