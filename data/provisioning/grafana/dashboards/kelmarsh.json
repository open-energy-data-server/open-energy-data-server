    {
      "type": "stat",
      "title": "Wind farm in the selected range",
      "description": "Capacity factor refers to 2050 kW rated power per turbine (Senvion MM92, assumption - the rated power is not stored in the data). Energy is the sum of the 10 minute energy_export (kWh).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(energy_export)/1e6 AS \"Energy\", 100.0*avg(power)/2050 AS \"Capacity factor\", avg(wind_speed) AS \"Mean wind speed\", max(power) AS \"Max turbine power\", count(DISTINCT turbine) AS \"Turbines\"\nFROM kelmarsh.scada WHERE $__timeFilter(datetime)"
        }
      ],
