    {
      "type": "trend",
      "title": "Power duration curve of $turbine",
      "description": "Power of the selected turbine sorted from highest to lowest: x is the share of time (%) in which the power is exceeded. A flat part at the left means the turbine runs at rated power.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (1-p)*100 AS \"Share of time exceeded (%)\", percentile_cont(p) WITHIN GROUP (ORDER BY power) AS \"Power\"\nFROM kelmarsh.scada, generate_series(0, 1, 0.02) p WHERE $__timeFilter(datetime) AND turbine = '$turbine' GROUP BY p ORDER BY p DESC"
        }
      ],
      "fieldConfig": {
