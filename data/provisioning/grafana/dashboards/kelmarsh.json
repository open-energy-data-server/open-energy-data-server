          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT wind_speed AS \"Wind speed (m/s)\", power AS \"Power (kW)\" FROM kelmarsh.scada WHERE $__timeFilter(datetime) AND turbine = '$turbine' AND wind_speed IS NOT NULL AND (extract(epoch from datetime)::bigint/600) % 2 = 0"
        }
