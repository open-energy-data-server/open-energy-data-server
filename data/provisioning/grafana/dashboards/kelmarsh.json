            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT lpad(floor(wind_speed)::int::text, 2, '0') || '-' || (floor(wind_speed)::int + 1) || ' m/s' AS \"Wind speed class\", 100.0*count(*)/sum(count(*)) OVER () AS \"All turbines (%)\" FROM kelmarsh.scada WHERE $__timeFilter(datetime) AND wind_speed IS NOT NULL GROUP BY 1 ORDER BY 1"
