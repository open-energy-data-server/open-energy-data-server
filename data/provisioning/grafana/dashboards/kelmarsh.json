    {
      "type": "table",
      "title": "Turbine comparison",
      "description": "Capacity factor refers to 2050 kW rated power per turbine (Senvion MM92, assumption - the rated power is not stored in the data). Availability = share of expected 10 minute values present. Standstill = share of intervals with wind > 4 m/s but power <= 0 (stops, faults, curtailment).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT turbine AS \"Turbine\", sum(energy_export)/1000 AS \"Energy (MWh)\", 100.0*avg(power)/2050 AS \"Capacity factor (%)\", avg(wind_speed) AS \"Mean wind (m/s)\", 100.0*count(*)/GREATEST(1, extract(epoch from ($__timeTo()::timestamptz - $__timeFrom()::timestamptz))/600) AS \"Availability of data (%)\", 100.0*count(*) FILTER (WHERE wind_speed > 4 AND power <= 0)/count(*) AS \"Standstill at wind > 4 m/s (%)\"\nFROM kelmarsh.scada WHERE $__timeFilter(datetime) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Energy (MWh)"
