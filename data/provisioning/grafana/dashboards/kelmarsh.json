    {
      "type": "trend",
      "title": "Daily profile of the wind farm by season",
      "description": "Mean capacity factor of all turbines by hour of the day (Europe/London) for the meteorological seasons in the selected range. Capacity factor refers to 2050 kW rated power per turbine (Senvion MM92, assumption - the rated power is not stored in the data). ",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT extract(hour from datetime AT TIME ZONE 'Europe/London')::int AS \"Hour\", 100.0*avg(power) FILTER (WHERE extract(month from datetime) IN (12,1,2))/2050 AS \"Winter (DJF)\", 100.0*avg(power) FILTER (WHERE extract(month from datetime) IN (3,4,5))/2050 AS \"Spring (MAM)\", 100.0*avg(power) FILTER (WHERE extract(month from datetime) IN (6,7,8))/2050 AS \"Summer (JJA)\", 100.0*avg(power) FILTER (WHERE extract(month from datetime) IN (9,10,11))/2050 AS \"Autumn (SON)\"\nFROM kelmarsh.scada WHERE $__timeFilter(datetime) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisPlacement": "auto",
            "spanNulls": true
          },
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "xField": "Hour",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
