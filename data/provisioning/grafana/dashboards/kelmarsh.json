    {
      "type": "xychart",
      "title": "Power vs wind speed of $turbine (10 min values)",
      "description": "Every second 10 minute value of the selected turbine. The scatter around the curve is caused by gusts, direction and wake effects, and curtailment/stops (points at 0 kW).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
