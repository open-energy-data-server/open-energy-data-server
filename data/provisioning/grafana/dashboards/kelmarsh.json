    {
      "type": "timeseries",
      "title": "Wind farm power and wind speed",
      "description": "Sum of the turbine power (left axis) and mean wind speed of the turbines (right axis) per time bin.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, sum(p) AS \"Farm power\", avg(w) AS \"Wind speed\" FROM (SELECT $__timeGroupAlias(datetime,$__interval), turbine, avg(power) AS p, avg(wind_speed) AS w FROM kelmarsh.scada WHERE $__timeFilter(datetime) GROUP BY 1,2) x GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "axisPlacement": "auto",
            "gradientMode": "none"
          },
          "unit": "kwatt"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Wind speed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "velocityms"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
