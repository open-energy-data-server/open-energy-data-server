    {
      "type": "barchart",
      "title": "Wind speed distribution",
      "description": "Share of 10 minute values per 1 m/s wind speed class  (all turbines).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
