    {
      "type": "barchart",
      "title": "Monthly energy per turbine",
      "description": "Exported energy per month and turbine (kWh, 10 minute values summed). Differences between turbines show wake effects and downtime.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(date_trunc('month', datetime), 'YYYY-MM') AS \"Month\", sum(energy_export) FILTER (WHERE turbine='KWF1')/1000 AS \"KWF1\", sum(energy_export) FILTER (WHERE turbine='KWF2')/1000 AS \"KWF2\", sum(energy_export) FILTER (WHERE turbine='KWF3')/1000 AS \"KWF3\", sum(energy_export) FILTER (WHERE turbine='KWF4')/1000 AS \"KWF4\", sum(energy_export) FILTER (WHERE turbine='KWF5')/1000 AS \"KWF5\", sum(energy_export) FILTER (WHERE turbine='KWF6')/1000 AS \"KWF6\"\nFROM kelmarsh.scada WHERE $__timeFilter(datetime) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "gradientMode": "none",
            "axisPlacement": "auto"
          },
          "unit": "MWh"
