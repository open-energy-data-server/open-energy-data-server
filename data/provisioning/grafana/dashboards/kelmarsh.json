    {
      "type": "trend",
      "title": "Measured power curve per turbine",
      "description": "Mean power per 0.5 m/s wind speed bin (nacelle anemometer) for each turbine. The curves reach ~2050 kW at ~12 m/s; deviations between turbines show anemometer or performance differences.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT floor(wind_speed*2)/2 + 0.25 AS \"Wind speed (m/s)\", avg(power) FILTER (WHERE turbine='KWF1') AS \"KWF1\", avg(power) FILTER (WHERE turbine='KWF2') AS \"KWF2\", avg(power) FILTER (WHERE turbine='KWF3') AS \"KWF3\", avg(power) FILTER (WHERE turbine='KWF4') AS \"KWF4\", avg(power) FILTER (WHERE turbine='KWF5') AS \"KWF5\", avg(power) FILTER (WHERE turbine='KWF6') AS \"KWF6\"\nFROM kelmarsh.scada WHERE $__timeFilter(datetime) AND wind_speed IS NOT NULL AND wind_speed < 25 GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisPlacement": "auto",
            "spanNulls": true
