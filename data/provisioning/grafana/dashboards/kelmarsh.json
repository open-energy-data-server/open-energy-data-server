            "properties": [
              {
                "id": "unit",
                "value": "MWh"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Capacity factor (%)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Mean wind (m/s)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "velocityms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Availability of data (%)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Standstill at wind > 4 m/s (%)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
