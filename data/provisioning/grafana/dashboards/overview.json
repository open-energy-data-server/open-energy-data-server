    {
      "type": "stat",
      "title": "Hypertables",
      "description": "Anzahl Timescale-Hypertables (Zeitreihentabellen).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
