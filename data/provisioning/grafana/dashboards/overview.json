  "description": "Zentrale Übersicht des Open Energy Data Servers: Aktualität der laufend aktualisierten Quellen, Datenbankgröße je Schema und Links zu allen OEDS-Dashboards. Alter = Zeit seit dem neuesten Zeitstempel der Haupttabelle (grün unter 2 Tagen, orange unter 7 Tagen, rot darüber). Quellen mit Datenverzug (z.B. Gas-Tage oder Netzbetreiberdaten) können dauerhaft etwas älter sein.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "title": "OEDS dashboards",
      "tags": [
        "oeds"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": false,
      "icon": "external link",
      "tooltip": "",
      "targetBlank": false,
      "url": ""
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Aktualität der Datenquellen",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Alter der neuesten Daten",
      "description": "Tage seit dem neuesten Datenpunkt der Haupttabelle je Quelle. Grün unter 2 Tagen, orange unter 7 Tagen, rot ab 7 Tagen.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select quelle, tabelle, letzter_wert, round((extract(epoch from (now() - letzter_wert))/86400)::numeric, 1)::float as alter_tage from (\nselect 'ENTSO-E (Last)' as quelle, 'entsoe.query_load' as tabelle, max(\"index\") as letzter_wert from entsoe.query_load\nunion all select 'SMARD (Erzeugung)' as quelle, 'smard.generation' as tabelle, max(datum_von) as letzter_wert from smard.generation\nunion all select 'ENTSOG (physische Flüsse)' as quelle, 'entsog.physical_flow' as tabelle, max(periodfrom) as letzter_wert from entsog.physical_flow\nunion all select 'GIE AGSI (Gasspeicher)' as quelle, 'gie.gie_agsi_country' as tabelle, max(gasdaystart)::timestamptz as letzter_wert from gie.gie_agsi_country\nunion all select 'eview (Netzfrequenz/Verbrauch)' as quelle, 'eview.eview' as tabelle, max(datetime) as letzter_wert from eview.eview\nunion all select 'JAO (Auktionen)' as quelle, 'jao.auctions' as tabelle, max(\"date\") as letzter_wert from jao.auctions\nunion all select 'Regelleistung (FCR)' as quelle, 'regelleistung.fcr_ergebnisse' as tabelle, max(date_from) as letzter_wert from regelleistung.fcr_ergebnisse\nunion all select 'ECMWF (Wetter EU)' as quelle, 'ecmwf.ecmwf_eu' as tabelle, max(\"time\") at time zone 'UTC' as letzter_wert from ecmwf.ecmwf_eu\nunion all select 'Instrat (EU ETS)' as quelle, 'instrat_pl.eu_ets' as tabelle, max(\"date\") at time zone 'UTC' as letzter_wert from instrat_pl.eu_ets\nunion all select 'OPEC (Ölpreis)' as quelle, 'opec.opec' as tabelle, max(\"date\") at time zone 'UTC' as letzter_wert from opec.opec) f order by alter_tage desc",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: d",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 7
              }
            ]
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^alter_tage$/",
          "values": true
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "justifyMode": "auto"
      },
      "id": 2,
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "table",
      "title": "Neueste Zeitstempel",
      "description": "Neuester Zeitstempel der Haupttabelle je Quelle (Spalte siehe Tabellenname) und Alter in Tagen. ENTSO-E und SMARD enthalten teils Daten bis in die nahe Zukunft (Prognosen). ECMWF und OPEC werden aktuell nicht mehr aktualisiert (letzte Werte im Februar 2026).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select quelle, tabelle, letzter_wert, round((extract(epoch from (now() - letzter_wert))/86400)::numeric, 1)::float as alter_tage from (\nselect 'ENTSO-E (Last)' as quelle, 'entsoe.query_load' as tabelle, max(\"index\") as letzter_wert from entsoe.query_load\nunion all select 'SMARD (Erzeugung)' as quelle, 'smard.generation' as tabelle, max(datum_von) as letzter_wert from smard.generation\nunion all select 'ENTSOG (physische Flüsse)' as quelle, 'entsog.physical_flow' as tabelle, max(periodfrom) as letzter_wert from entsog.physical_flow\nunion all select 'GIE AGSI (Gasspeicher)' as quelle, 'gie.gie_agsi_country' as tabelle, max(gasdaystart)::timestamptz as letzter_wert from gie.gie_agsi_country\nunion all select 'eview (Netzfrequenz/Verbrauch)' as quelle, 'eview.eview' as tabelle, max(datetime) as letzter_wert from eview.eview\nunion all select 'JAO (Auktionen)' as quelle, 'jao.auctions' as tabelle, max(\"date\") as letzter_wert from jao.auctions\nunion all select 'Regelleistung (FCR)' as quelle, 'regelleistung.fcr_ergebnisse' as tabelle, max(date_from) as letzter_wert from regelleistung.fcr_ergebnisse\nunion all select 'ECMWF (Wetter EU)' as quelle, 'ecmwf.ecmwf_eu' as tabelle, max(\"time\") at time zone 'UTC' as letzter_wert from ecmwf.ecmwf_eu\nunion all select 'Instrat (EU ETS)' as quelle, 'instrat_pl.eu_ets' as tabelle, max(\"date\") at time zone 'UTC' as letzter_wert from instrat_pl.eu_ets\nunion all select 'OPEC (Ölpreis)' as quelle, 'opec.opec' as tabelle, max(\"date\") at time zone 'UTC' as letzter_wert from opec.opec) f order by alter_tage desc",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "alter_tage"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: d"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 2
                    },
                    {
                      "color": "red",
                      "value": 7
                    }
                  ]
                }
              },
              {
                "id": "color",
