    {
      "type": "stat",
      "title": "Schemas",
      "description": "Anzahl Schemas mit Daten (ohne System- und Timescale-Schemas).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select count(*) as n from information_schema.schemata where schema_name not like 'pg\\_%' and schema_name not like '\\_timescaledb%' and schema_name not in ('information_schema','public')",
          "refId": "A"
        }
      ],
      "fieldConfig": {
